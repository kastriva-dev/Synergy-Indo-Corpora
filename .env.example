# Public content GAS read-only
GAS_WEB_APP_URL=

# Google Identity Services (public client ID; not a secret)
GOOGLE_CLIENT_ID=
ADMIN_ALLOWED_EMAILS=
ADMIN_SESSION_SECRET=

# Private Apps Script admin gateway — server only
GAS_ADMIN_WEB_APP_URL=
GAS_ADMIN_SECRET=

# Upstash Redis REST — server only, required for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recruitment privacy gate — keep disabled until company/legal approval
CANDIDATE_PRIVACY_NOTICE_VERSION=
CANDIDATE_PRIVACY_NOTICE_APPROVED=false
CANDIDATE_RETENTION_DAYS=

# Scheduled retention cleanup — server only
CRON_SECRET=
