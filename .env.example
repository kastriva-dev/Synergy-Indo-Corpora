# Public content GAS read-only (from Stage 2)
GAS_WEB_APP_URL=

# Stage 3: Google Identity Services (OAuth Client type: Web application).
# This is a PUBLIC client ID, not a Google client secret.
GOOGLE_CLIENT_ID=
# List of authorized administrator email addresses, separated by commas.
ADMIN_ALLOWED_EMAILS=
# Random 64+ characters. SERVER ONLY. Different from GAS_ADMIN_SECRET.
ADMIN_SESSION_SECRET=

# Stage 3: Separate Apps Script admin deployment. SERVER ONLY.
GAS_ADMIN_WEB_APP_URL=
# 64+ random chars, must match script property SYNERGY_ADMIN_SECRET.
GAS_ADMIN_SECRET=

# Stage 3.10: Upstash Redis REST for distributed rate limiting and one-time login nonces.
# SERVER ONLY. Required in Vercel Preview/Production before admin APIs are enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
