# Temporary meeting-preview CMS only (public read-only site/programs/gallery endpoint).
# Remove after the meeting/content migration so Firebase becomes the CMS source.
GAS_WEB_APP_URL=

# Firebase project fields — service-account values are server-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase Web API key is public by design; restrict APIs and authorized domains.
FIREBASE_WEB_API_KEY=

# Existing Google Identity Services client ID for nonce-validated admin sign-in.
GOOGLE_CLIENT_ID=
ADMIN_ALLOWED_EMAILS=
ADMIN_SESSION_SECRET=

# Upstash Redis REST — server-only distributed rate limits and single-use login nonce
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recruitment privacy gate — keep disabled until written company/legal approval.
CANDIDATE_PRIVACY_NOTICE_VERSION=
CANDIDATE_PRIVACY_NOTICE_APPROVED=false
CANDIDATE_RETENTION_DAYS=

# Scheduled retention cleanup — server only
CRON_SECRET=
